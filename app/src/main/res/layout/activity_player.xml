<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"

    android:layout_height="match_parent"
    tools:context=".PlayerActivity"
    android:orientation="vertical"
    android:background="#000000"
    android:weightSum="10"
    >

    <LinearLayout
        android:id="@+id/mainlayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"

        android:gravity=""
        android:orientation="vertical">

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="50dp">


    <Button
        android:id="@+id/btnfav"
        android:layout_width="30dp"
        android:layout_height="28dp"
        android:layout_marginLeft="150dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="30dp"

        android:background="@drawable/ic_fav" />

    <Button
        android:id="@+id/btnMic"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="30dp"
        android:layout_toRightOf="@+id/btnfav"
        android:background="@drawable/ic_mic"/>

    <Button
        android:id="@+id/btnEq"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:layout_toRightOf="@+id/btnMic"
        android:background="@drawable/ic_equalizer" />

</RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnback"
                android:layout_width="30dp"
                android:layout_height="31dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"

                android:background="@drawable/ic_back" />

            <TextView
                android:id="@+id/txtSong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
android:layout_toRightOf="@id/btnback"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:padding="8dp"
                android:singleLine="true"
                android:text="New Song is loading......"

                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="16dp"
                android:textStyle="italic" />
        </RelativeLayout>


        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/imgView"

            android:layout_gravity="center"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/picon"
            />

            </LinearLayout>

    <RelativeLayout

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"

        android:gravity="right"
        android:orientation="vertical">



    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:gravity="center"
        android:orientation="vertical">



        <RelativeLayout
            android:layout_width="match_parent"

            android:layout_height="60dp">

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_pause"
                android:drawableTint="#403E3E" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:layout_toRightOf="@+id/btnPlay"
                android:background="@drawable/ic_next"
                android:backgroundTint="#B6B5B5" />

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:layout_toLeftOf="@+id/btnPlay"
                android:background="@drawable/ic_previous" />

            <Button
                android:id="@+id/btnRepeat"
                android:layout_width="35dp"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_toRightOf="@+id/btnNext"
                android:background="@drawable/ic_repeat" />

            <Button
                android:id="@+id/btnShuffle"
                android:layout_width="35dp"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_toLeftOf="@+id/btnPrevious"
                android:background="@drawable/ic_shuffle"

                app:iconTint="#FFFFFF" />



        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_marginTop="15dp"
            android:layout_height="60dp">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="300dp"
                android:layout_height="24dp"
                android:layout_alignParentBottom="true"

                android:layout_centerInParent="true"
                android:layout_marginStart="2dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="20dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                >


                <TextView
                    android:id="@+id/txtSongStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_alignParentLeft="true"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="25dp"
                    android:singleLine="true"
                    android:text="0:20"
                    android:textColor="@color/white"
                    android:textSize="10dp" />

                <TextView
                    android:id="@+id/txtSongEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_alignParentRight="true"
                    android:layout_centerInParent="true"
                    android:layout_marginRight="25dp"
                    android:singleLine="true"
                    android:text="5:15"
                    android:textColor="@color/white"
                    android:textSize="10dp" />

            </RelativeLayout>

        </RelativeLayout>



    </LinearLayout>





</LinearLayout>