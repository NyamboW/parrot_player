<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="5dp"
    android:paddingEnd="12dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/playlistCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_surface_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="9dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/playlistCoverCard"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="#1E2430"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgPlaylistCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_nav_playlist_item"
                app:tint="#9AA3B2" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPlaylistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Playlist Name"
                android:textColor="#F5F7FA"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/txtPlaylistCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:singleLine="true"
                android:text="0 tracks"
                android:textColor="#8F98A8"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgPlaylistArrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#5E6775" />
    </LinearLayout>

</LinearLayout>
