<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="76dp">

        <!-- Header Row: Compact Icon + Title / Version / ABI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="2dp"
                app:cardBackgroundColor="#151922"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/appLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="PARROT"
                    android:textColor="#F5F7FA"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/appVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="v1.0"
                    android:textColor="#E2E6EE"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtDeviceSpec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="arm64-v8a, api 35"
                    android:textColor="#8F98A8"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Attribution Block (aligned under title) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:paddingStart="56dp">

            <TextView
                android:id="@+id/txtCopyrightLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="© 2026, attomaticsystems"
                android:textColor="#E2E6EE"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/txtAboutAccentTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Offline Audio Player • Built with Native DSP"
                android:textColor="#4CAF50"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Section 1: About Player -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="top"
            android:orientation="horizontal">

            <View
                android:id="@+id/bulletAboutPlayer"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="31dp"
                android:background="#4CAF50" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="About Player:"
                    android:textColor="#F5F7FA"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Parrot is a clean, lightweight offline audio player designed for instant library browsing, smart folder filtering, synchronized lyrics, and custom sound effects."
                    android:textColor="#9AA3B2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 2: Developed By -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:orientation="horizontal">

            <View
                android:id="@+id/bulletDeveloper"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="31dp"
                android:background="#4CAF50" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Developer:"
                    android:textColor="#F5F7FA"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="attomaticsystems"
                    android:textColor="#9AA3B2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 3: Audio Formats & DSP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:orientation="horizontal">

            <View
                android:id="@+id/bulletAudioEngine"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="31dp"
                android:background="#4CAF50" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Supported Formats &amp; Audio Engine:"
                    android:textColor="#F5F7FA"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="MP3, FLAC, WAV, M4A, AAC, OGG • 5-Band EQ, Bass Boost, Reverb, Crossfade, Skip Silence, A–B Loop &amp; LRC Lyrics"
                    android:textColor="#9AA3B2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 4: Third Party Libraries -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:orientation="horizontal">

            <View
                android:id="@+id/bulletLibraries"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="31dp"
                android:background="#4CAF50" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Third party libraries:"
                    android:textColor="#F5F7FA"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AndroidX &amp; Material Components"
                    android:textColor="#D5DCE6"
                    android:textSize="12.5sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© Google LLC (Apache License 2.0)"
                    android:textColor="#8F98A8"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Navigation &amp; ConstraintLayout"
                    android:textColor="#D5DCE6"
                    android:textSize="12.5sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© The Android Open Source Project (Apache 2.0)"
                    android:textColor="#8F98A8"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Dexter Runtime Permissions"
                    android:textColor="#D5DCE6"
                    android:textSize="12.5sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© Karumi (Apache License 2.0)"
                    android:textColor="#8F98A8"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="CircleImageView"
                    android:textColor="#D5DCE6"
                    android:textSize="12.5sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© Henning Dodenhof (Apache License 2.0)"
                    android:textColor="#8F98A8"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Flexible Spacer to Anchor Footer Links -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <!-- Bottom Action Links -->
        <TextView
            android:id="@+id/btnAboutChangelog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Change Log"
            android:textColor="#4CAF50"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/btnAboutPrivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Privacy &amp; Offline Policy"
            android:textColor="#4CAF50"
            android:textSize="13.5sp" />

    </LinearLayout>
</ScrollView>
