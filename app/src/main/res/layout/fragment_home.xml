<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/homeTopContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#0B0B0F"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- Minimal Modern Pill Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#0B0B0F"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:tabBackground="@android:color/transparent"
            app:tabIndicator="@drawable/tab_pill_indicator"
            app:tabIndicatorColor="#4CAF50"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="stretch"
            app:tabMode="scrollable"
            app:tabPaddingEnd="16dp"
            app:tabPaddingStart="16dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextAppearance="@style/ParrotTabText"
            app:tabTextColor="#8A93A2" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#151922" />
    </LinearLayout>

</FrameLayout>
