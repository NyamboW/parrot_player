            android:action="com.attomaticsystems.parrotplayer.SHORTCUT_SHUFFLE_ALL"
            android:targetPackage="com.attomaticsystems.parrotplayer"
            android:targetClass="com.attomaticsystems.parrotplayer.MainActivity" />
    </shortcut>

    <shortcut
